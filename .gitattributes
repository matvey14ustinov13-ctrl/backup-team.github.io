# Keep shell scripts and source files with LF line endings, even when the
# repository is checked out on Windows.
*.sh            text eol=lf
*.c             text eol=lf
*.h             text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.conf          text eol=lf
*.x86_64        text eol=lf

# Binary assets must never be converted.
*.png           binary
*.jpg           binary
*.iso           binary
*.zip           binary
*.z01           binary
*.z02           binary
